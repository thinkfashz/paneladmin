NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PocketBase
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# InsForge
INSFORGE_BASE_URL=
INSFORGE_ANON_KEY=
INSFORGE_PROJECT_ID=
INSFORGE_ACCESS_LOGS_ENDPOINT=

# Security
# ACCESS_LOG_SECRET firma las sesiones. Si no lo defines, el asistente de
# primer inicio (/setup) genera uno fuerte y lo guarda cifrado en .fabrick/.
DEMO_TOKEN_SECRET=
ACCESS_LOG_SECRET=

# Setup wizard (primer inicio)
# FABRICK_CONFIG_KEY: clave hex de 64 caracteres para cifrar .fabrick/config.enc
#   (opcional; si falta se genera una en .fabrick/config.key).
# FABRICK_SETUP_FORCE=true reabre el asistente /setup aunque ya este bloqueado.
FABRICK_CONFIG_KEY=
FABRICK_SETUP_FORCE=

# Solo desarrollo local: NUNCA habilitar en produccion (queda bloqueado
# automaticamente cuando NODE_ENV=production).
DEV_SUPERADMIN_MODE=
NEXT_PUBLIC_DEFAULT_DEMO_HOURS=72
SECURITY_ALLOWED_ORIGINS=http://localhost:3000
SECURITY_ENABLE_STRICT_CSP=false

# Future integrations
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
